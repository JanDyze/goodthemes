{
  "name": "goodthemes",
  "version": "0.1.0",
  "description": "Full-atmosphere themes for shadcn/Tailwind apps: palette, type, texture, motion and ambient effects.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./script": {
      "types": "./dist/script.d.ts",
      "import": "./dist/script.js"
    },
    "./styles.css": "./dist/styles.css",
    "./base.css": "./dist/base.css",
    "./exile.css": "./dist/exile.css",
    "./eden.css": "./dist/eden.css",
    "./deluge.css": "./dist/deluge.css",
    "./babel.css": "./dist/babel.css",
    "./cana.css": "./dist/cana.css",
    "./jericho.css": "./dist/jericho.css",
    "./shepherd.css": "./dist/shepherd.css",
    "./big-fish.css": "./dist/big-fish.css",
    "./furnace.css": "./dist/furnace.css",
    "./galilee.css": "./dist/galilee.css",
    "./empty-tomb.css": "./dist/empty-tomb.css",
    "./pentecost.css": "./dist/pentecost.css",
    "./ekklesia.css": "./dist/ekklesia.css",
    "./zion.css": "./dist/zion.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsup && node scripts/build-css.mjs",
    "dev": "vite --config playground/vite.config.ts",
    "playground:build": "vite build --config playground/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "sigils": "node scripts/trace-emblems.mjs",
    "draw-sigils": "node scripts/draw-emblems.mjs",
    "logo": "node scripts/trace-logo.mjs",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jimp": "^0.22.12",
    "lucide-react": "^1.48.0",
    "potrace": "^2.1.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
